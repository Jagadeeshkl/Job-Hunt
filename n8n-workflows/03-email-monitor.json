{
  "name": "03 — Email Monitor",
  "nodes": [
    {
      "id": "cron-15min",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [200, 300],
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "*/15 * * * *" }]
        }
      }
    },
    {
      "id": "run-email-monitor",
      "name": "Run Email Monitor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [450, 300],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3002/run/email-monitor",
        "options": { "timeout": 120000 }
      }
    }
  ],
  "connections": {
    "Every 15 Minutes": { "main": [[{ "node": "Run Email Monitor", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
