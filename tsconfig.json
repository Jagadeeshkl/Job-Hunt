{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": "./agents",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["agents/**/*"],
  "exclude": ["node_modules", "dashboard", "dist"]
}
